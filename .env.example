# Supabase: transaction pooler (port 6543); URL-encode password characters.
DATABASE_URL=
# Direct/session connection for migrations; falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Only set false for local PostgreSQL without TLS.
DATABASE_SSL=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

APP_URL=http://localhost:3000
LIVE_SEND_ENABLED=false
SENDGRID_API_KEY=
UNSUBSCRIBE_SECRET=
INBOUND_WEBHOOK_SECRET=
SENDGRID_EVENT_PUBLIC_KEY=
SENDGRID_PARSE_PUBLIC_KEY=
INBOUND_REPLY_DOMAIN=
# Set this for Vercel Cron or any authenticated external scheduler.
CRON_SECRET=
# Legacy scheduler name remains supported.
SCHEDULER_SECRET=
LEAD_API_URL=
LEAD_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RENTCAST_API_KEY=
TRACERFY_API_KEY=
# Initial setup (keep these outside the dashboard and identical across deployments).
# CONFIG_DATABASE_URL points to the original Supabase pooler; do not change it
# when switching the workspace database from the dashboard.
CONFIG_DATABASE_URL=
# Generate each secret once; keep values stable to retain saved configuration/sessions.
CONFIG_ENCRYPTION_KEY=
