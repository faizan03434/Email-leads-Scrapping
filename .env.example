# ─────────────────────────────────────────────────────────────────────────────
# LEADFLOW — ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your values.
# NEVER commit .env with real credentials to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── LICENSED LEAD PROVIDER (optional) ────────────────────────────────────────
LEAD_API_URL=
LEAD_API_KEY=

# ── SENDGRID EMAIL DELIVERY ───────────────────────────────────────────────────
SENDGRID_API_KEY=
APP_URL=http://localhost:5173
LIVE_SEND_ENABLED=false

# ── SECURITY SECRETS (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ──
UNSUBSCRIBE_SECRET=
INBOUND_WEBHOOK_SECRET=
SCHEDULER_SECRET=

# ── SENDGRID WEBHOOKS (production only) ──────────────────────────────────────
SENDGRID_EVENT_PUBLIC_KEY=
SENDGRID_PARSE_PUBLIC_KEY=
INBOUND_REPLY_DOMAIN=

# ── ADZUNA JOB BOARD (free — developer.adzuna.com) ───────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── RENTCAST PROPERTY DATA (app.rentcast.io) ─────────────────────────────────
RENTCAST_API_KEY=
